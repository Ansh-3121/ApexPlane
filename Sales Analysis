 -- checking outlier from age
 with ranked as ( select age , Row_number() over (order by age ) as rn,
 count(*) over () as total_rows
 from apex1 where age is not null ) ,
q as (select ( select age as q1 from ranked where rn =ceil(0.25 * total_rows)) as q1 ,
(select age as q1 from ranked where rn =ceil(0.75 * total_rows)) as q3 ) 

select  q1,q3,q3-q1 as iqr,q1-1.5*(q3-q1) as lower_fence,
q3 + 1.5*(q3-q1) as upper_fence from q;
 
 
